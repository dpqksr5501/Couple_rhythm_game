# =============================================================================
# Two Hearts, One Beat (커플 리듬게임) - 환경 설정 템플릿 (.env.example)
# =============================================================================
# 사용 방법:
# 1. 이 파일을 복사하여 프로젝트 루트에 '.env' 이름으로 저장하세요.
#    (PowerShell: Copy-Item .env.example .env)
# 2. 본인의 Firebase 프로젝트 ID로 수정하세요.
# 3. .env 파일은 절대 Git에 커밋하거나 외부에 공유하지 마세요.
# =============================================================================

# [필수] Firebase 프로젝트 고유 ID (Firestore Database)
FIREBASE_PROJECT_ID=your-firebase-project-id

# [필수] Firebase 프로젝트 설정의 Web API Key (스태프 로그인)
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
